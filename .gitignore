# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# Database
*.db
*.sqlite3

# Environment
.env
*.env.local

# Node
node_modules/
dist/
.cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Docker
.docker/

# Logs
*.log
logs/

# v3.31 — usage-history monthly report files (runtime output + test artifacts)
/reports/
backend/reports/
tests/test_reports/

# v3.43 — runtime output directories, none of which belong in the repo.
# They were swept in by a `git add -A backend frontend mobile` in 41090ca and removed
# again in the commit that added these lines. Ignored so the next broad add cannot
# repeat it: a generated QR PNG per test cabinet is noise that hides the real diff.
backend/static/qr/
backend/backgrounds/
backend/data/
frontend/test-results/

# Generated documents at the repo root are OUTPUTS of scripts/generate_*.py — the scripts are
# the source and are committed; the PDF/DOCX they write are not. (Two older outputs are still
# tracked from before this rule: Cloud_IOT_ERP_Integration_Guide_v3.pdf, docs/User Guide.docx.)
/*.pdf
/*.docx

# .deb build output — DEB_Pack/README.md and build_deb.sh are source; the package tree under
# opt/ and the built .deb are not. DEB_Pack v1.0.0 (2026-02-28) is OBSOLETE: never install from it.
DEB_Pack/*.deb
DEB_Pack/package/opt/

# Test evidence goes into the report, not the repo. (Files committed here before this rule
# remain tracked until someone decides to remove them.)
tests/evidence/

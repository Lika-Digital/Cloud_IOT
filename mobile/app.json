{
  "expo": {
    "name": "Marina IoT",
    "slug": "marina-iot",
    "version": "1.0.0",
    "scheme": "marina-iot",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NFCReaderUsageDescription": "Marina IoT reads the NFC tag on a pedestal socket to start your charging session."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-video",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Marina IoT reads the NFC tag on a pedestal socket to start your charging session.",
          "includeNdefEntitlement": true
        }
      ]
    ]
  }
}

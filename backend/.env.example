# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# ── Admin seed credentials (used only on first run if no users exist) ─────────
DEFAULT_ADMIN_EMAIL=admin@your-domain.local
DEFAULT_ADMIN_PASSWORD=change-me-on-first-login

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to print OTPs to the console (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# ── MQTT broker ───────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ── CORS (comma-separated origins) ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Company / branding (used in generated PDFs) ───────────────────────────────
COMPANY_NAME=Your Marina Name
COMPANY_ADDRESS=Street 1, 12345 City, Country
COMPANY_PHONE=+1 234 567 890
COMPANY_EMAIL=info@your-marina.com
COMPANY_PORTAL_NAME=Marina IoT Portal

# ── NFC / ERP integration (v3.26+) ────────────────────────────────────────────
# ERP_API_KEY: the static key myMarina sends as X-API-Key on every /api/nfc/
# request. Leave EMPTY to disable the NFC endpoints entirely (they answer 503).
ERP_API_KEY=
# Optional HTTPS endpoint we POST session updates to. Empty = no webhook.
ERP_WEBHOOK_URL=

# Which of the two topologies this marina runs.
#   false (default) = MODE 1, WITH ERP.    app -> ERP -> pedestal. ERP bills.
#   true            = MODE 2, WITHOUT ERP. app -> pedestal.  THE PEDESTAL BILLS.
# Marina-wide, not per-cabinet: it says whether an ERP exists at this site.
NFC_DIRECT_CLIENT_MODE=false

# ┌──────────────────────────────────────────────────────────────────────────────
# │ READ THIS BEFORE PROVISIONING WATER NFC TAGS
# │
# │ A cabinet has SIX tags: Q1-Q4 on the electricity sockets and V1/V2 on the
# │ water outlets. Electricity tags are safe to provision at any time.
# │
# │ WATER tags need a mobile app built at v3.43 or later. Older builds cannot
# │ resolve a "V1" outlet, and their session-adoption check treats an
# │ unresolved outlet as "matches anything" — so a customer who scans a water
# │ tag is shown, and in MODE 2 CHARGED FOR, another customer's electricity
# │ session. That is a wrong invoice, not a display glitch.
# │
# │ The backend ENFORCES this: while NFC_DIRECT_CLIENT_MODE=true and this flag
# │ is false, provisioning a V1/V2 tag is refused with 409 and an explanation.
# │ MODE 1 sites are exempt and need not set it — there the ERP resolves the
# │ tag and calls /api/nfc/scan itself, so no app version is in the path.
# │
# │ Set this to true only once the updated app is DEPLOYED TO CUSTOMERS, not
# │ when the build exists.
# └──────────────────────────────────────────────────────────────────────────────
MOBILE_APP_SUPPORTS_WATER_NFC=false

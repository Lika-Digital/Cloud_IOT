#!/usr/bin/env bash
# Installed by scripts/install_git_hooks.sh — edit there, not here, or the change is lost.
REPO_ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "🔍 Pre-commit: fast gate (pytest + bandit + gap checks)"
echo ""

GATE_LEVEL=fast bash "$REPO_ROOT/tests/run_tests.sh"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌  Commit aborted — the fast gate failed."
    echo "    The reason is in the WHY IT FAILED block above — it is printed last"
    echo "    precisely so reading this output through 'tail' cannot hide it."
    echo "    The full gate (semgrep, pip-audit, mobile tsc, Playwright) runs on push."
    echo ""
    exit 1
fi

echo ""
echo "✅  Fast gate passed — committing."
echo ""
exit 0

# Cloud IoT Guard — camera person detection worker.
#
# Installed by nuc_image/install-guard.sh, which does NOT enable or start it. The first start
# is its own step (docs/ui_v2_spec.md §13): it needs the camera URL in guard.env, which is a
# cabinet fact and carries the camera's password.
#
# Layout mirrors the repo on purpose: guard_worker/__main__.py puts its parent directory and
# <parent>/backend on sys.path, so the worker at /opt/cloud-iot/guard_worker finds the shared
# modules (app.guard.pipeline, app.guard.alarm_rule, app.services.yolo_openvino) in the
# backend upgrade.sh already deploys. Only those import here; they are stdlib+numpy+PIL,
# enforced by test_guard_import_isolation.py, so no backend dependency enters this venv and
# openvino never enters the backend's.

[Unit]
Description=Cloud IoT Guard — camera person detection worker
Documentation=https://github.com/Lika-Digital/Cloud_IOT
# Ordering only, NOT a hard dependency: guard must boot whether or not the backend is
# healthy, and must survive the backend restarting under it.
After=network-online.target docker.service cloud-iot-backend.service
Wants=network-online.target

[Service]
Type=simple
User=guard
Group=guard
WorkingDirectory=/opt/cloud-iot
EnvironmentFile=/opt/cloud-iot/guard/guard.env
ExecStart=/opt/cloud-iot/guard/.venv/bin/python -m guard_worker

# on-failure, not always: a clean exit is not fought. Exit 2 (no camera URL) and 4 (no
# instance id) are configuration, and StartLimitBurst stops them hammering the box.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# Resource ceiling = the <15 %-of-4-cores acceptance budget, kernel-enforced. CPUQuota is %
# of ONE cpu: 60 % of one core = 15 % of a 4-core box. Measured need 27.3 % at 1 fps.
CPUQuota=60%
MemoryMax=1G
Nice=10
IOSchedulingClass=idle

# Egress: the broker and the camera LAN, nothing else (owner, 2026-10-13). Everything is
# addressed by IP, so no DNS is needed. Three entries, each MEASURED (2026-10-13, systemd 255,
# Docker 29.1.3, the real worker against mosquitto in a container on a user bridge):
#   localhost       — the worker connects to 127.0.0.1:1883. With Docker's default
#                     userland-proxy the peer is docker-proxy on loopback, and this suffices.
#   172.18.0.0/16   — with userland-proxy=false the kernel DNATs 127.0.0.1:1883 to the
#                     container (172.18.0.2 on cabinet 1) and the filter sees the address
#                     AFTER the rewrite: without this entry the worker could not connect.
#                     Which mode the NUC runs is a §13 check, as is the container's address.
#   192.168.1.0/24  — the camera LAN (cabinet 1's camera: 192.168.1.191).
# A blocked connection looks exactly like a dead camera or broker ("connection refused" /
# timeout); §13 says how to tell the two apart before anyone goes looking for a fault.
IPAddressDeny=any
IPAddressAllow=localhost 172.18.0.0/16 192.168.1.0/24
# A request, not a barrier: OpenVINO honours it by choice. The two lines above are the barrier.
Environment=OPENVINO_TELEMETRY_OPT_OUT=1

# Filesystem: writes exactly one place.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/marina-guard
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

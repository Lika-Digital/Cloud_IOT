#!/usr/bin/env bash
# ============================================================================
# cloud-iot — Cloud IoT NUC management CLI
#
# Version-controlled (nuc_image/cloud-iot) and deployed to /usr/local/bin/cloud-iot
# by both installers (ubuntu-install.sh / ubuntu-install-26.04.sh) via:
#     install -m 0755 "${REPO_DIR}/nuc_image/cloud-iot" /usr/local/bin/cloud-iot
#
# To update the CLI on a running NUC without a full reinstall:
#     git -C ~/Cloud_IOT pull origin main
#     sudo cp ~/Cloud_IOT/nuc_image/cloud-iot /usr/local/bin/cloud-iot
#     sudo chmod +x /usr/local/bin/cloud-iot
# ============================================================================
APP_DIR="/opt/cloud-iot"
VENV="${APP_DIR}/backend/.venv"

case "${1:-}" in
  start)   systemctl start  cloud-iot-compose cloud-iot-backend nginx ;;
  stop)    systemctl stop   cloud-iot-backend cloud-iot-compose ;;
  restart) systemctl restart cloud-iot-compose cloud-iot-backend nginx ;;
  status)
    for svc in cloud-iot-compose cloud-iot-backend nginx; do
      echo "── $svc ──"
      systemctl status "$svc" --no-pager -l 2>/dev/null | head -6
      echo ""
    done ;;
  logs)
    case "${2:-backend}" in
      backend)  journalctl -u cloud-iot-backend -f --no-pager ;;
      nginx)    tail -f /var/log/nginx/error.log ;;
      mqtt)     docker logs -f pedestal-mqtt-broker ;;
      *)        journalctl -u "cloud-iot-${2}" -f --no-pager ;;
    esac ;;
  config)   "${EDITOR:-nano}" /opt/cloud-iot/backend/.env \
              && systemctl restart cloud-iot-backend ;;
  ip)       hostname -I | awk '{print $1}' ;;
  upgrade)
    set -o pipefail
    echo "[cloud-iot] Stopping backend..."
    systemctl stop cloud-iot-backend

    # ── Locate the cloned repo ──────────────────────────────────────────────
    REPO_DIR=""
    for candidate in ~/Cloud_IOT /home/*/Cloud_IOT /root/Cloud_IOT; do
      [ -d "$candidate/.git" ] && REPO_DIR="$candidate" && break
    done
    [ -n "$REPO_DIR" ] || { echo "[cloud-iot] ERROR: Cannot find Cloud_IOT git repo. Clone it and re-run upgrade."; exit 1; }

    echo "[cloud-iot] Pulling latest code from $REPO_DIR ..."
    git -C "$REPO_DIR" pull origin main || { echo "[cloud-iot] ERROR: git pull failed."; exit 1; }

    echo "[cloud-iot] Copying updated application..."
    for d in backend frontend; do
      [ -d "${REPO_DIR}/${d}" ] && cp -r "${REPO_DIR}/${d}/." "${APP_DIR}/${d}/"
    done
    find "${APP_DIR}/backend" -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

    # ── NUC adaptations: PDF (reportlab) + simulator are disabled on the NUC ──
    cat > "${APP_DIR}/backend/app/services/simulator_manager.py" << 'SIMEOF'
"""Simulator disabled on NUC deployment."""
class _Stub:
    is_running = False
    def start(self, **kwargs): pass
    def stop(self): pass
simulator_manager = _Stub()
SIMEOF
    sed -i '/reportlab/d' "${APP_DIR}/backend/requirements.txt" 2>/dev/null || true

    echo "[cloud-iot] Rebuilding frontend..."
    ( cd "${APP_DIR}/frontend" && npm ci --prefer-offline --no-audit --no-fund && npm run build && rm -rf node_modules ) \
      || { echo "[cloud-iot] ERROR: frontend build failed."; exit 1; }

    # ── Python venv: recreate ONLY if pip is missing (avoids needless re-downloads) ──
    if [ ! -x "${VENV}/bin/pip" ]; then
      echo "[cloud-iot] Python venv missing/broken — recreating..."
      rm -rf "${VENV}"
      PYBIN=""
      for v in python3.14 python3.13 python3.12 python3.11 python3; do
        command -v "$v" >/dev/null 2>&1 && PYBIN="$v" && break
      done
      [ -n "$PYBIN" ] || { echo "[cloud-iot] ERROR: no python3 interpreter found."; exit 1; }
      "$PYBIN" -m venv "${VENV}" || { echo "[cloud-iot] ERROR: venv creation failed."; exit 1; }
      "${VENV}/bin/pip" install --upgrade pip setuptools wheel \
        || { echo "[cloud-iot] ERROR: pip bootstrap failed."; exit 1; }
    fi

    # ── Build a Python-version-aware requirements file ───────────────────────
    # On Python >= 3.13 the pinned numpy 2.1 / pydantic 2.9 / scikit-learn 1.5 /
    # Pillow have no wheels — relax to floor pins so pip picks a 3.14-compatible
    # release instead of attempting an impossible source build.
    PY_MM="$("${VENV}/bin/python" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")')"
    REQ_SRC="${APP_DIR}/backend/requirements.txt"
    REQ_RUN="${APP_DIR}/backend/requirements.runtime.txt"
    if [ "$(printf '%s\n' '3.13' "$PY_MM" | sort -V | head -1)" = "3.13" ]; then
      echo "[cloud-iot] Python ${PY_MM} detected — relaxing numpy/pydantic/scikit-learn/Pillow pins"
      sed -E \
        -e 's/^numpy==.*/numpy>=2.2/' \
        -e 's/^pydantic==.*/pydantic>=2.10/' \
        -e 's/^pydantic-settings==.*/pydantic-settings>=2.6/' \
        -e 's/^scikit-learn==.*/scikit-learn>=1.6/' \
        -e 's/^Pillow.*/Pillow>=11.0/' \
        "$REQ_SRC" > "$REQ_RUN"
    else
      cp "$REQ_SRC" "$REQ_RUN"
    fi

    echo "[cloud-iot] Updating Python packages..."
    "${VENV}/bin/pip" install --prefer-binary -r "$REQ_RUN" \
      || { echo "[cloud-iot] ERROR: pip install failed — backend NOT restarted (left on previous state). Fix the error above and re-run 'sudo cloud-iot upgrade'."; exit 1; }

    echo "[cloud-iot] Restarting services..."
    systemctl start cloud-iot-backend
    systemctl restart nginx
    echo "[cloud-iot] Upgrade complete."
    ;;
  version)
    echo "Cloud IoT NUC management CLI"
    for d in "$APP_DIR" "$HOME/Cloud_IOT"; do
      if git -C "$d" rev-parse &>/dev/null 2>&1; then
        git -C "$d" log -1 --format="%h %s (%ci)" 2>/dev/null && break
      fi
    done ;;
  *)
    echo "Usage: sudo cloud-iot {start|stop|restart|status|logs [backend|nginx|mqtt]|config|ip|upgrade|version}"
    ;;
esac
